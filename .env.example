# ═══════════════════════════════════════════════════════════════════
# TERMÓMETRO SOCIAL DE JUJUY — VARIABLES DE ENTORNO
# ═══════════════════════════════════════════════════════════════════

# 1. Google Gemini AI (Modelo Regional y Análisis de Emociones)
# Obtén tu clave gratuita en: https://aistudio.google.com/
GEMINI_API_KEY=

# 2. APIs Oficiales de Redes Sociales
# Meta Graph API (Instagram Reels / Facebook Pages públicas de Jujuy)
META_GRAPH_ACCESS_TOKEN=
META_PAGE_ID_JUJUY=

# TikTok Display API (Comentarios en videos y trends locales)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# 3. Scrapers de Apoyo y Webhooks (Opcional - ej: Apify)
APIFY_API_TOKEN=

# 4. Configuración del Servidor y Base de Datos
PORT=8000
LOG_LEVEL=INFO
SCRAPER_INTERVAL=60
